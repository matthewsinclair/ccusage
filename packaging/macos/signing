# How Ccusage's macOS binary is signed and notarized: the one place these facts live.
# bin/.devbin/cmd/macos signs, notarizes and checks with them, and tests/macos.bats
# holds packaging/homebrew/ccusage.rb's copy of the requirement equal to this one.
# keychain is the login keychain's service prefix for the notary credentials,
# <keychain>.APPLE_ID, <keychain>.APPLE_APP_PASSWORD and <keychain>.APPLE_TEAM_ID,
# which Geodica's other releases use too. key=value lines.
identity=Developer ID Application: Geodica Pty Ltd (76BQL8L47U)
team=76BQL8L47U
keychain=geodica.apple
identifier=com.geodica.ccusage
requirement=identifier "com.geodica.ccusage" and anchor apple generic and certificate leaf[subject.OU] = "76BQL8L47U" and certificate leaf[field.1.2.840.113635.100.6.1.13] exists
