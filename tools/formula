#!/bin/sh
# Render the versioned template or publish it using the maintainer's Git/gh login.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
mode=${1:-}
tag=${2:-}
case "$mode" in render|publish) ;; *) echo "Usage: tools/formula render TAG OUTPUT | publish TAG TAP_CHECKOUT" >&2; exit 2 ;; esac
if [ "$#" -ne 3 ]; then echo "Expected TAG and output path/tap checkout" >&2; exit 2; fi
if ! printf '%s\n' "$tag" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "Expected a stable release tag such as v0.1.0" >&2
  exit 2
fi
git -C "$root" show-ref --verify --quiet "refs/tags/$tag"
revision=$(git -C "$root" rev-parse --verify "refs/tags/$tag^{commit}")
version=$(git -C "$root" show "$tag:Cargo.toml" | sed -n 's/^version = "\([^"]*\)"$/\1/p')
if [ "$tag" != "v$version" ]; then echo "Tag does not match Cargo.toml version" >&2; exit 1; fi
output=$3
if [ "$mode" = publish ]; then
  tap=$output
  if [ -n "$(git -C "$tap" status --porcelain)" ]; then echo "Tap checkout must be clean" >&2; exit 1; fi
  if [ "$(git -C "$tap" branch --show-current)" != main ]; then echo "Tap checkout must be on main" >&2; exit 1; fi
  # Verify the exact repository, including SSH aliases, without changing Git auth.
  owner=$(cd "$tap" && gh repo view --json nameWithOwner --jq .nameWithOwner)
  if [ "$owner" != matthewsinclair/homebrew-ccusage ]; then echo "Unexpected tap repository" >&2; exit 1; fi
  remote_revision=$(gh api "repos/matthewsinclair/ccusage/commits/$tag" --jq .sha)
  if [ "$remote_revision" != "$revision" ]; then echo "Release tag is not published at the expected commit" >&2; exit 1; fi
  mkdir -p "$tap/Formula"
  output=$tap/Formula/ccusage.rb
fi
stage=$(mktemp)
trap 'rm -f "$stage" "$stage.template"; rm -rf "$stage.assets"' 0 HUP INT TERM
git -C "$root" show "$tag:packaging/homebrew/ccusage.rb" > "$stage.template"
arm_sha=
intel_sha=
if grep -q '@RELEASE_ARM_SHA256@' "$stage.template"; then
  [ "$(gh release view "$tag" --repo matthewsinclair/ccusage --json isDraft --jq .isDraft)" = false ] || {
    echo "Release is still a draft; refusing to update the tap" >&2; exit 1;
  }
  mkdir "$stage.assets"
  gh release download "$tag" --repo matthewsinclair/ccusage --dir "$stage.assets" --pattern SHA256SUMS --pattern MACOS-SIGNING.json
  python3 - "$stage.assets" "$tag" > "$stage" <<'PYCODE'
import json, re, sys
from pathlib import Path
root, tag = Path(sys.argv[1]), sys.argv[2]
manifest = json.loads((root / 'MACOS-SIGNING.json').read_text())
assert (manifest['tag'], manifest['identifier'], manifest['team_id']) == (tag, 'com.geodica.ccusage', '76BQL8L47U'), 'Signing manifest mismatch'
checksums = {}
for line in (root / 'SHA256SUMS').read_text().splitlines():
    digest, name = line.split()
    assert name not in checksums and re.fullmatch('[0-9a-f]{64}', digest), 'Invalid checksum manifest'
    checksums[name] = digest
for target in ['aarch64-apple-darwin', 'x86_64-apple-darwin']:
    name = f'ccusage-{tag}-{target}.tar.gz'
    assert manifest['archives'][name]['sha256'] == checksums[name], 'Signing checksum mismatch'
    print(checksums[name])
PYCODE
  arm_sha=$(sed -n '1p' "$stage")
  intel_sha=$(sed -n '2p' "$stage")
fi
sed -e "s/@RELEASE_TAG@/$tag/g" -e "s/@RELEASE_REVISION@/$revision/g" \
  -e "s/@RELEASE_VERSION@/$version/g" -e "s/@RELEASE_ARM_SHA256@/$arm_sha/g" \
  -e "s/@RELEASE_INTEL_SHA256@/$intel_sha/g" "$stage.template" > "$stage"
if grep -q '@RELEASE_' "$stage"; then echo "Unresolved formula placeholder" >&2; exit 1; fi
cat "$stage" > "$output"
if [ "$mode" = publish ]; then
  git -C "$tap" add -- Formula/ccusage.rb
  if git -C "$tap" diff --cached --quiet; then
    echo "Tap is already at $tag"
  else
    git -C "$tap" commit -m "Update ccusage to $tag"
  fi
  # A previous run may have committed the update but failed during its push.
  git -C "$tap" push origin HEAD:refs/heads/main
fi
