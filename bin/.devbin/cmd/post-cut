#!/usr/bin/env zsh
# devbin: summary = everything after a cut: sign, notarize and publish CI's draft, publish the formula, pull this Mac's tap
# devbin: group = Ship
#
# bin/devbin post-cut: the release core's one after: line (bin/.devbin/config.yaml),
# so `bin/devbin release vX.Y.Z` runs from the cut to the tap under its one yes.
#
#   bin/devbin post-cut [<tag>]   <tag> defaults to the cut's (DEVBIN_RELEASE_CONFIRMED), else v<Cargo.toml's version>
#
# In order, stopping at the first failure: bin/devbin macos finalize <tag>, which
# signs and notarizes the Mac archives in CI's draft and publishes it, then
# bin/devbin formula publish, then this Mac's clone of the tap pulled. The core's
# object step (object: ci) has waited for CI's draft before any after: line runs.
#
# ONE LINE, NOT THREE: the core runs every after: line even when one before it
# failed, and formula publish reads the SHA256SUMS only a finished finalize writes.
#
# A RE-RUN SKIPS WHAT IS DONE: finalize verifies a release already public and
# changes nothing, and formula publish leaves a tap that carries the render as it
# is. Run by the cut, formula publish takes the cut's yes; run by hand, it asks.
#
# NO WORKTREE, unlike Pplr's: nothing here builds. finalize signs CI's archives,
# fetched from GitHub, and neither step reads a file a board commit changes.

emulate -L zsh
setopt err_exit no_unset pipe_fail

root=${0:A:h:h:h:h}
cd $root

die() { print -u2 -r -- "post-cut: $*"; exit 1 }
say() { print -r -- "post-cut: $*" }

case ${1:-} in
  -h|--help) sed -n '/^#   bin\/devbin post-cut/,/^#$/p' ${0:A} | sed -e '$d' -e 's/^# \{0,1\}//'; exit 0 ;;
esac
(( $# <= 1 )) || die "usage: bin/devbin post-cut [<tag>]"
[[ $(uname) == Darwin ]] || die "the Mac archives are signed and notarized on macOS only; this is $(uname)"

# The tap, as formula publish names it: brew keeps its clone at Library/Taps/<owner>/<repo>
tap=$(sed -n 's/^  tap: //p' bin/.devbin/config.yaml | head -1)
[[ -n $tap ]] || die "bin/.devbin/config.yaml names no formula tap"
tap=${${tap%.git}//:/\/}
tap=${tap:h:t}/${tap:t}

version=$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)
tag=${1:-${DEVBIN_RELEASE_CONFIRMED:-v$version}}
[[ $(git cat-file -t "refs/tags/$tag" 2>/dev/null) == tag ]] || die "'$tag' is not an annotated tag here, so it is not a release"
commit=$(git rev-parse --verify "$tag^{commit}")
# formula publish renders the newest release, whatever it is asked, so an older
# tag here would sign one release and publish another's formula
newest=$(git tag --list 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname | head -1)
[[ $tag == $newest ]] || die "'$tag' is not the newest release ($newest), and formula publish publishes the newest"

say "ccusage $tag at ${commit[1,12]}"
say "bin/devbin macos finalize $tag"
bin/devbin macos finalize $tag ||
  die "macos finalize failed at $tag; nothing after it ran. Fix the cause and run bin/devbin post-cut $tag"
say "bin/devbin formula publish"
bin/devbin formula publish ||
  die "formula publish failed; $tag is signed, notarized and public. Fix the cause and run bin/devbin post-cut $tag"

# This Mac's clone of the tap, pulled so brew upgrade sees the release: brew's
# auto-update can leave a third-party tap behind. The upgrade is the maintainer's.
if (( $+commands[brew] )); then
  brew_repo=$(brew --repository) || die "brew cannot name its repository; $tag is public and the tap published"
  tapdir=$brew_repo/Library/Taps/$tap
  if [[ -d $tapdir/.git ]]; then
    git -C $tapdir pull -q --ff-only ||
      die "cannot pull $tapdir; $tag is public and the tap published. Pull it by hand before brew upgrade"
    say "this Mac's tap: $(git -C $tapdir log -1 --format=%s)"
  fi
fi
say "ccusage $tag: signed, notarized and public, and the tap published"
